PORT=3000
# На Амвере добавьте YANDEX_PUBLIC_URL в переменные/секреты и перезапустите приложение.
# Значение — публичная ссылка на корневую папку, содержащую папки предприятий электрических сетей.
YANDEX_PUBLIC_URL=
# PostgreSQL во внутренней сети Amvera. Значения задаются только в окружении.
DB_HOST=
DB_PORT=
DB_NAME=
DB_USER=
DB_PASSWORD=
# Необязательно после увеличения памяти Amvera, если cgroup не сообщает новый лимит.
# Значение в МБ, например 2048; реальный лимит cgroup всегда имеет приоритет.
PREPARE_MEMORY_MB=
# Необязательно: общий доступ к приложению через HTTP Basic Auth на HTTPS.
# При использовании публичного Диска это защищает приложение, а не сам Диск.
APP_USER=
APP_PASSWORD=
